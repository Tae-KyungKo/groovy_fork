# Groovy 백엔드 MSA 스택 공통 환경변수 예시.
#
# 사용법: 이 파일을 .env로 복사한 뒤 필요한 값을 채운다.
#   cp .env.example .env
#
# docker-compose.local.yml/docker-compose.example.yml은 여기 없는 값이면 안전한 로컬용
# 기본값을 그대로 쓴다. docker-compose.prod.yml은 아래 비밀값들을 ${VAR:?...} 문법으로
# 필수 지정했으므로, .env 없이 띄우면 기동 자체가 실패한다(의도된 동작).

# --- MySQL (mysql-init/*.sql이 서비스별 스키마+전용 계정을 별도로 만든다) ---
MYSQL_ROOT_PASSWORD=rootpassword
IDENTITY_DB_PASSWORD=identity_service_local_only_pw
STUDY_DB_PASSWORD=study_service_local_only_pw
CONTENT_DB_PASSWORD=content_service_local_only_pw
CALENDAR_DB_PASSWORD=calendar_service_local_only_pw
NOTIFICATION_DB_PASSWORD=notification_service_local_only_pw

# --- Kafka (SASL/PLAIN 클라이언트 인증, kafka-init/adminclient.conf 참고) ---
KAFKA_BROKER_PASSWORD=broker-secret
KAFKA_APP_PASSWORD=app-secret

# --- CORS (프론트엔드 출처) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 호스트에 노출할 포트 (docker-compose.local.yml/example만 해당 — prod는 api-gateway/
# grafana만 노출하고 나머지는 컴포즈 내부 네트워크에서만 접근 가능하다) ---
MYSQL_PORT=3306
API_GATEWAY_PORT=8080
API_GATEWAY_MGMT_PORT=8090
IDENTITY_SERVICE_PORT=8081
STUDY_SERVICE_PORT=8082
CONTENT_SERVICE_PORT=8083
CALENDAR_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085
TEMPO_QUERY_PORT=3200
LOKI_PORT=3100
GRAFANA_PORT=3000
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9093
